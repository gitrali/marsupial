; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/accessibility_support=2

[application]

config/name="project_possums"
config/description="a game made in godot"
config/version="0.0.0"
config/use_hidden_project_data_directory=false
config/disable_project_settings_override=true
config/features=PackedStringArray("4.7", "Forward Plus")
run/delta_smoothing=false
boot_splash/bg_color=Color(0.9647059, 0.9647059, 0.9647059, 1)
boot_splash/stretch_mode=4
boot_splash/use_filter=false
boot_splash/image="uid://d14s41v5pnxpn"
config/icon="uid://86v0lvve46on"
config/windows_native_icon="res://icon.ico"

[display]

window/size/mode=4
window/size/initial_position_type=4
window/size/resizable=false
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0

[gui]

theme/custom_font="uid://dqi82nnwt7mog"
theme/voxel_gi/quality=0

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=2
textures/canvas_textures/default_texture_repeat=1
rendering_device/driver.windows="d3d12"
